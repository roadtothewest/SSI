TEXT -1280 -1008 Left 4 ;AuraVox - AFE sEMG: 4 canales diferenciales, 9 electrodos (4 pares + RLD), 4 salidas ADC1..ADC4
TEXT -1280 -928 Left 3 ;Prueba general: senoidal (73/131/211/307 Hz) 10x menor que el ruido en los 4 canales, RLD activo, USB a PC
TEXT -1280 -864 Left 2 ;Flujo: ESTIMULO -> ELECTRODOS -> CANAL (x4) -> ADC.  Doble clic en un bloque CANAL (o clic derecho > Open Hierarchy) para ver sus 8 etapas.
RECTANGLE Normal -1280 -800 -224 -256 2
TEXT -1256 -760 Left 3 ;ALIMENTACION 3.3 V Y VREF 1.65 V
TEXT -1256 -712 Left 2 ;divisor 2 x 100k + 10u, seguidor MCP6004
RECTANGLE Normal -160 -800 1408 -256 2
TEXT -136 -760 Left 3 ;CUERPO Y RED 50 Hz
TEXT -136 -712 Left 2 ;CMB red-cuerpo, CBE cuerpo-tierra, CGE circuito-tierra (20p bateria, 1 = USB a PC)
RECTANGLE Normal -1280 -192 -224 2464 2
TEXT -1256 -152 Left 3 ;ESTIMULO POR CANAL
TEXT -1256 -104 Left 2 ;diferencial, entre el cuerpo y el electrodo +
RECTANGLE Normal -160 -192 704 2464 2
TEXT -136 -152 Left 3 ;ELECTRODOS (8 de senal)
TEXT -136 -104 Left 2 ;20k||47n; el - de cada par + 51k||47n
RECTANGLE Normal 768 -192 1472 2464 2
TEXT 792 -152 Left 3 ;AFE: 4 CANALES
TEXT 792 -104 Left 2 ;bloque CANAL = 8 etapas
TEXT -1248 0 Left 3 ;CH1  submentoniano
TEXT -1248 608 Left 3 ;CH2  platisma
TEXT -1248 1216 Left 3 ;CH3  labio inferior
TEXT -1248 1824 Left 3 ;CH4  laringe
RECTANGLE Normal 1536 -192 2848 928 2
TEXT 1560 -152 Left 3 ;RLD (9o electrodo, clavicula)
TEXT 1560 -104 Left 2 ;integrador inversor; sensa el punto medio de RG de los 4 canales (604k c/u)
TEXT 1568 48 Left 2 ;RLDMODE 2 = RLD activo (RLIM 390k) | 1 = sin RLD: ref. pasiva a VREF por 390k (RPAS) | 0 = ref. directa
RECTANGLE Normal 1536 992 2848 2464 2
TEXT 1560 1032 Left 3 ;SIMULACION
TEXT 1560 1080 Left 2 ;Correr (Run) y graficar ADC1..ADC4. 0.5 s tarda ~3 min. CASE=2: senoidal 100x menor; CASE=0: sin ruido.
TEXT 1568 1184 Left 2 !.include opa.lib\n.include models/ina_behav.lib\n.include afe_channel.lib\n.param CASE=1\n.param RATIO={if(CASE==2,100,10)} KN={if(CASE==0,0,1)}\n.param NLF=1m NWH=300u NTOT={sqrt(NLF**2+NWH**2)} AS={NTOT*sqrt(2)/RATIO}\n.param F1=73 F2=131 F3=211 F4=307\n.func stim(f,a,b) {AS*sin(2*pi*f*time)+KN*(NLF*a+NWH*b)}\n.param RLDMODE=2 CINT=1n RLIM=390k RS=100k CCM=47p CD=100p\n.param CMB=3p RIMB=51k RER=20k\n.param CGE=1 VMAINS_TRAN={if(CASE==0,0,311)} VMAINS_AC=0\n.tran 0 0.5 0 50u\n.param RLIM_EF={if(RLDMODE==2,RLIM,1T)} RPAS_EF={if(RLDMODE==2,1T,if(RLDMODE==1,RLIM,1))}\n.options gmin=100f plotwinsize=0
