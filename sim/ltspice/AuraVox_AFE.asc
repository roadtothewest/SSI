TEXT 2488 -152 Left 3 ;RLD (9o electrodo, clavicula)
TEXT 2488 -104 Left 2 ;integrador inversor; sensa el punto medio de RG de los 4 canales
TEXT 2496 48 Left 2 ;RLDMODE 2 = con RLD (RLIM 390k) | 1 = sin RLD: ref. pasiva a VREF por 390k (RPAS)
RECTANGLE Normal 2464 992 3776 1504 2
TEXT 2488 1032 Left 3 ;VALORES (editar aqui si cambias un componente)
TEXT 2488 1080 Left 2 ;E24; el bloque CANAL los usa en sus 3 copias
TEXT 2496 1184 Left 2 !.param RS=100k RRFI=1k CCM=47p CD=100p RGH=2.7k\n.param CHP=100n RHP1=56k RHP2=110k\n.param RM1=3k RM2=75k RM3=20k CM1=68n CM2=1n\n.param RLB=56k C21=15n C22=2.2n\n.param RBK=100 CBK=1n RSM=620k CINT=1n RLIM=390k
RECTANGLE Normal 2464 1568 3776 3040 2
TEXT 2488 1608 Left 3 ;ESTIMULO Y SIMULACION
TEXT 2488 1656 Left 2 ;KN=0 quita el ruido. AS = sEMG (V rms); GE = ECG pico; NMOV/NWHT calibrados a 500/20 uV rms
TEXT 2496 1760 Left 2 !.param KN=1 KSEM=25 NMOV=4.28m NWHT=82.4u\n.param AS1=50u AS2=40u AS3=25u\n.param GE1=120u GE2=50u GE3=250u\n.param CMB=3p RIMB=51k RER=20k CGE=1 VMAINS_TRAN=311 VMAINS_AC=0\n.param GDK={1.8/3.3}\n.include opa.lib\n.include models/ina_behav.lib\n.include afe_channel.lib\n.step param RLDMODE list 1 2\n.param RLIM_EF={if(RLDMODE==2,RLIM,1T)} RPAS_EF={if(RLDMODE==2,1T,if(RLDMODE==1,RLIM,1))}\n.tran 0 1.2 0 50u\n.options gmin=100f plotwinsize=0\n.meas tran CM_cuerpo_Vpp PP V(body)-V(vref) FROM 0.3 TO 1.2\n.meas tran sEMG1_uVrms RMS 1e6*V(semg1) FROM 0.35 TO 0.49\n.meas tran ADC1_rafaga_mVrms RMS 1000*(V(adc1)-1.65) FROM 0.35 TO 0.49\n.meas tran ADC1_reposo_mVrms RMS 1000*(V(adc1)-1.65) FROM 0.58 TO 0.70\n.meas tran SNR1_salida_dB param 20*log10(ADC1_rafaga_mVrms/ADC1_reposo_mVrms)\n.meas tran PIN1_min_V MIN V(pin1) FROM 0.3 TO 1.2\n.meas tran PIN1_max_V MAX V(pin1) FROM 0.3 TO 1.2\n.meas tran sEMG2_uVrms RMS 1e6*V(semg2) FROM 0.35 TO 0.49\n.meas tran ADC2_rafaga_mVrms RMS 1000*(V(adc2)-1.65) FROM 0.35 TO 0.49\n.meas tran ADC2_reposo_mVrms RMS 1000*(V(adc2)-1.65) FROM 0.58 TO 0.70\n.meas tran SNR2_salida_dB param 20*log10(ADC2_rafaga_mVrms/ADC2_reposo_mVrms)\n.meas tran PIN2_min_V MIN V(pin2) FROM 0.3 TO 1.2\n.meas tran PIN2_max_V MAX V(pin2) FROM 0.3 TO 1.2\n.meas tran sEMG3_uVrms RMS 1e6*V(semg3) FROM 0.35 TO 0.49\n.meas tran ADC3_rafaga_mVrms RMS 1000*(V(adc3)-1.65) FROM 0.35 TO 0.49\n.meas tran ADC3_reposo_mVrms RMS 1000*(V(adc3)-1.65) FROM 0.58 TO 0.70\n.meas tran SNR3_salida_dB param 20*log10(ADC3_rafaga_mVrms/ADC3_reposo_mVrms)\n.meas tran PIN3_min_V MIN V(pin3) FROM 0.3 TO 1.2\n.meas tran PIN3_max_V MAX V(pin3) FROM 0.3 TO 1.2
RECTANGLE Normal -1600 3104 3776 3680 2
TEXT -1576 3144 Left 3 ;BoM (3 canales, a comprar; detalle en docs/afe-emg/BoM_AFE_AuraVox.xlsx)
TEXT -1568 3216 Left 2 ; 10 x 100k  resistencia\n  4 x 100p  cond. ceramico C0G\n  8 x 100n  cond. poliester (film)\n  4 x 75k  resistencia\n  4 x 15n  cond. poliester o C0G\n  3 x 10u  cond. ceramico/electrolitico\n  6 x TS922AIYDT  Op-amp doble TS922 (rail-to-rail, 4 MHz)\n  3 x 1u  cond. ceramico/electrolitico\n 50 x 3M Red Dot 2228/2560  Electrodo Ag/AgCl con broche\n  3 x 2.54 mm  Tira de headers macho/hembra
TEXT -224 3216 Left 2 ; 16 x 1N4148  diodo\n  4 x INA333 modulo MCU-333  INA333 (modulo MCU-333)\n 12 x 56k  resistencia\n  4 x 20k  resistencia\n  4 x 2.2n  cond. poliester o C0G\n  4 x 620k  resistencia\n  7 x SOIC8 a DIP8  Adaptador SOIC-8 a DIP-8\n  1 x 3xAA  Portapilas 3 x AA\n  8 x broche 4 mm  Cable con broche (snap) para electrodo\n  1 x 24 AWG rigido  Cable para puentes
TEXT 1120 3216 Left 2 ;  8 x 1k  resistencia\n 10 x 2.7k  resistencia\n  4 x 110k  resistencia\n  4 x 68n  cond. poliester o C0G\n  4 x 100  resistencia\n  2 x 10M  resistencia\n  7 x DIP-8  Zocalo DIP-8\n  6 x AA  Pilas AA\n  1 x Alcohol isopropilico / gel  Alcohol isopropilico / gel
TEXT 2464 3216 Left 2 ;  8 x 47p  cond. ceramico C0G\n 12 x 100n  cond. ceramico/electrolitico\n  4 x 3k  resistencia\n 10 x 1n  cond. ceramico C0G\n  5 x jumper Dupont  Cable a Arduino A1..A3 del STM32N6570-DK\n  2 x 390k  resistencia\n  2 x MCP1700-3302E TO-92  Regulador LDO 3.3 V\n  1 x deslizante  Interruptor\n  2 x 10 x 15 cm  Perfboard
