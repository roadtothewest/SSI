```mermaid
block-beta
  columns 6

  block:skin:1
    columns 1
    block:flex:2
      columns 1
      IIS3DWB("IIS3DWB<br/>LGA-14L<br/>2.5×3mm")
      FPC("Flex PCB<br/>0.1mm polyimide<br/>Adhesivo médico 3M 1526L")
    end
    Piel("Piel (laringe)")
  end

  space:1

  block:stm32:2
    columns 3
    SPI("SPI1<br/>10 MHz<br/>DMA PP")
    I2S("I2S3<br/>DMA circ")
    TIM("TIM2<br/>sync<br/>1 MHz")
    USB("USB CDC<br/>Bulk EP")
  end

  space:1

  INMP441("INMP441<br/>MEMS mic<br/>I2S 16 kHz")

  space:2

  PC["PC (Linux Mint)<br/>ssr-ingest Go<br/>Dataset capture"]

  style skin fill:#f9e5d9,stroke:#d4735c
  style flex fill:#ffe0cc,stroke:#ff8c42
  style stm32 fill:#dae8fc,stroke:#6c8ebf
  style PC fill:#d5e8d4,stroke:#82b366

  IIS3DWB --> SPI
  INMP441 --> I2S
  TIM --> SPI
  TIM --> I2S
  SPI --> USB
  I2S --> USB
