```mermaid
flowchart TB
  subgraph FlexPCB["Flex PCB Sensor"]
    direction TB
    POLY["Base Polyimide 0.1mm"] --> CU["Cobre 1/2 oz<br/>0.018mm"]
    CU --> COV["Coverlay 0.025mm"]
    COV --> PAD["Pads ENIG<br/>IIS3DWB LGA-14L<br/>ZIF Connector 6-pin"]
    PAD --> TOTAL["Total ~0.2mm<br/>Masa ~8mg"]
  end

  subgraph Adhesion["Acople Mecánico a Piel"]
    direction TB
    ADH1["3M 1526L<br/>Medical Tape<br/>0.18mm<br/>Hipoalergénico"]
    ADH2["Alternativa:<br/>Hydrocolloid<br/>Parche delgado"]
    ADH3["Bordes:<br/>Micropore tape<br/>Refuerzo perimetral"]
  end

  subgraph Cableado["Cableado a Main Board"]
    CB1["FPC ZIF 0.5mm pitch<br/>6 pines<br/>Longitud 10-15cm"]
    CB2["O alternativa:<br/>JST SH 1.0mm<br/>4 pines + par trenzado"]
  end

  subgraph Main["Main Board STM32"]
    NUCLEO["NUCLEO-H723ZG<br/>+ TPS7A LDO<br/>+ INMP441"]
  end

  FlexPCB --> Adhesion
  Adhesion -->|"Sobre laringe"| SKIN["Piel del cuello"]
  FlexPCB --> Cableado
  Cableado --> Main

  style FlexPCB fill:#ffe0cc,stroke:#ff8c42
  style Adhesion fill:#f9e5d9,stroke:#d4735c
  style Main fill:#dae8fc,stroke:#6c8ebf
