[Unit]
Description=AuraVox: ingesta SPI del STM32N6570-DK + HMI web
After=network-online.target
Wants=network-online.target

[Service]
User=aura
# Puerto 80 sin root: la HMI queda en http://auravox.lan
AmbientCapabilities=CAP_NET_BIND_SERVICE
SupplementaryGroups=spi gpio
WorkingDirectory=/home/aura
ExecStart=/usr/local/bin/auravoxd -src spi -addr :80 -data /home/aura/auravox -drdy 25 -gpiochip gpiochip0
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
